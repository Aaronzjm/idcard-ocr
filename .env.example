# 复制本文件为 .env 并按需修改（或在启动前 export 这些变量）
# 注意：本服务直接读环境变量，不依赖 python-dotenv 自动加载 .env。
# 如需 .env 自动加载，可自行引入 python-dotenv 或在启动命令前 source 本文件。

# 监听地址：本地调试 127.0.0.1，对外服务 0.0.0.0
OCR_HOST=127.0.0.1

# 监听端口
OCR_PORT=8000

# 允许跨域的来源，多个用逗号分隔；留空则不启用 CORS 中间件
# OCR_CORS_ORIGINS=https://example.com,https://app.example.com

# 是否开启 /docs 交互式接口文档（生产环境建议 false）
OCR_ENABLE_DOCS=false

# 是否允许视频检测接口访问内网地址（默认禁止，防 SSRF 探测内网）
OCR_ALLOW_PRIVATE_NETWORK=false

# 上传图片大小上限（字节，默认 5MB）
OCR_MAX_FILE_SIZE=5242880

# 视频检测单次下载超时（秒）
OCR_VIDEO_TIMEOUT=15
